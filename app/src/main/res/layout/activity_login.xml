<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="@drawable/bg_login_gradient">

    <!-- TITLE -->
    <TextView
        android:id="@+id/tvWelcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome to FitFeast!"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginBottom="16dp" />

    <!-- LOGO CARD -->
    <LinearLayout
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:background="@drawable/bg_white_card"
        android:gravity="center"
        android:elevation="8dp"
        android:layout_marginBottom="24dp">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/fitfeast_logo"
            android:contentDescription="FitFeast Logo" />
    </LinearLayout>

    <!-- EMAIL -->
    <EditText
        android:id="@+id/emailEt"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Email"
        android:textColorHint="@android:color/black"
        android:padding="12dp"
        android:background="@drawable/bg_input"
        android:inputType="textEmailAddress"
        android:layout_marginBottom="16dp"
        android:textColor="@android:color/black"/>

    <!-- PASSWORD -->
    <EditText
        android:id="@+id/passwordEt"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Password"
        android:textColorHint="@android:color/black"
        android:padding="12dp"
        android:background="@drawable/bg_input"
        android:inputType="textPassword"
        android:layout_marginBottom="24dp"
        android:textColor="@android:color/black"/>

    <!-- LOGIN BUTTON -->
    <Button
        android:id="@+id/loginBtn"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Login"
        android:textStyle="bold"
        android:background="@drawable/bg_login_button"
        android:layout_marginBottom="16dp"
        android:textColor="@android:color/black"/>

    <!-- GOOGLE SIGN IN -->
    <Button
        android:id="@+id/googleBtn"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Sign in with Google"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:background="@drawable/bg_google_button"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvSignup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Don't have an account yet? Sign up"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginTop="20dp"
        android:layout_gravity="center"
        android:clickable="true"
        android:focusable="true" />



</LinearLayout>
